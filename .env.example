# Este archivo es una plantilla.
# Como el proyecto es actualmente una aplicación 100% estática para el cliente (frontend),
# no hay variables de entorno en uso para la conexión con el servidor.

# Si en un futuro se añade una API (por ejemplo, para guardar calificaciones),
# se deben declarar aquí los endpoints o claves públicas (no secretas).
# Ejemplo futuro:
# VITE_API_URL=https://api.miapp.com/v1
# VITE_PUBLIC_TTS_KEY=xxx
